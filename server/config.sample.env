# Sample only. Do not put a real token in this file or commit one.
# The process refuses this placeholder and will not treat it as a credential.
GATEWAY_ACCESS_TOKEN=REPLACE_WITH_GATEWAY_ACCESS_TOKEN
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=43123
GATEWAY_BASE_PATH=
# unconfigured, mock, browser, or cli. browser does not mean Claude login succeeded.
REMOTE_CLAUDE_ADAPTER=unconfigured
# disabled keeps the browser process off. enabled starts a local browser only.
BROWSER_HOST=disabled
# BROWSER_EXECUTABLE=
# BROWSER_ALLOWLIST=
# BROWSER_HEADLESS=
# For cli, set an absolute directory owned by the dedicated service account.
# CLAUDE_CLI_CWD=/var/lib/remote-claude/workspace
# CLAUDE_CLI_MODELS=sonnet,opus,haiku
# CLAUDE_CLI_EXECUTABLE=/var/lib/remote-claude/.local/bin/claude
